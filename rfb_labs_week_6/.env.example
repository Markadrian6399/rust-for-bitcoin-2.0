# Copy this file to `.env` and adjust as needed. `.env` is git-ignored - it is where
# your seed phrase and RPC credentials actually live, never in source control.

# regtest | testnet | signet
BITCOIN_NETWORK=regtest

# Where the wallet's sqlite database lives (created automatically).
WALLET_DB_PATH=wallet_data/wallet.sqlite

# wpkh (BIP84 native segwit, default) | taproot (BIP86)
DESCRIPTOR_KIND=wpkh

# Bitcoin Core RPC connection. Match these to your `bitcoind -regtest` instance.
RPC_URL=127.0.0.1:18443
RPC_USER=
RPC_PASS=
# Alternatively, point at bitcoind's cookie file instead of RPC_USER/RPC_PASS:
# RPC_COOKIE=/path/to/.bitcoin/regtest/.cookie

# Left blank: `capstone_wallet init` generates a fresh BIP-39 mnemonic and writes it
# here automatically. Set it yourself to import an existing test seed instead.
# NEVER put a mainnet seed phrase here.
MNEMONIC=
MNEMONIC_PASSPHRASE=

# Advanced: bypass mnemonic derivation entirely and import raw descriptors instead
# (must include private key material, e.g. from `bdk_wallet`'s descriptor export).
# DESCRIPTOR=
# CHANGE_DESCRIPTOR=
